  "components": {
    "schemas": {
      "AttemptBatch": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AttemptInput"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "items"
        ],
        "title": "AttemptBatch"
      },
      "AttemptInput": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "selected_option": {
            "type": "string",
            "title": "Selected Option"
          },
          "hints_used": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Hints Used",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "selected_option"
        ],
        "title": "AttemptInput"
      },
      "AvailabilityInput": {
        "properties": {
