  "resources": [
    {
      "id": "resource-variables",
      "topic_id": "variables",
      "title": "Variables reference",
      "body": "Assignment binds a name to a value. Reassigning the same name changes the value used by later statements. Trace statements in order and record the current value after each assignment.",
      "source_label": "Original LearnNova reference example"
    },
    {
      "id": "resource-expressions",
      "topic_id": "expressions",
      "title": "Expressions reference",
      "body": "Evaluate multiplication before addition unless parentheses change grouping. Substitute the current variable values before calculating. Distinguish calculating an expression from assigning its result.",
      "source_label": "Original LearnNova reference example"
    },
    {
      "id": "resource-conditions",
      "topic_id": "conditions",
      "title": "Conditions reference",
      "body": "A condition evaluates to true or false. An if branch executes when its condition is true; an else branch handles the other case. Trace the chosen branch, then continue with statements after the conditional.",
      "source_label": "Original LearnNova reference example"
    },
    {
      "id": "resource-loops",
      "topic_id": "loops",
      "title": "Loops reference",
      "body": "For positive steps, range(start, stop) includes start and excludes stop. range(3) yields 0, 1, 2. An accumulator stores a result that changes each iteration. Use a table with iteration value and accumulator before/after the update.",
      "source_label": "Original LearnNova reference example"
    },
    {
      "id": "resource-lists",
      "topic_id": "lists",
      "title": "Lists reference",
      "body": "Python lists preserve element order. Index 0 refers to the first element. Index -1 refers to the last element. len returns the number of elements. Do not confuse an element value with its index.",
      "source_label": "Original LearnNova reference example"
    },
    {
      "id": "resource-list-iteration",
      "topic_id": "list-iteration",
      "title": "List iteration reference",
      "body": "A for loop over a list visits its values in order. A loop over range(len(items)) visits valid nonnegative index positions. Keep index and element value separate when explaining an output.",
      "source_label": "Original LearnNova reference example"
    },
    {
      "id": "resource-nested-loops",
      "topic_id": "nested-loops",
      "title": "Nested loops reference",
      "body": "For each iteration of the outer loop, the inner loop executes its own iterations. Trace pairs of outer and inner values in order. For independent fixed loop lengths m and n, the body runs m times n times.",
      "source_label": "Original LearnNova reference example"
    },
    {
      "id": "resource-functions",
      "topic_id": "functions",
      "title": "Functions reference",
      "body": "Calling a function binds argument values to its parameters and executes its body. return provides a value to the caller. Printing a value and returning it have different purposes; trace the call and the expression receiving the result.",
      "source_label": "Original LearnNova reference example"
    }
  ],
