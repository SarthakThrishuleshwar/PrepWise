{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalCreate",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_revision", "curriculum_id", "title", "start_date", "deadline", "targets", "availability"],
  "properties": {
    "expected_revision": {"type": "integer", "minimum": 0},
    "curriculum_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "goal_text": {"type": "string", "maxLength": 1000, "default": ""},
    "start_date": {"type": "string", "format": "date"},
    "deadline": {"type": "string", "format": "date"},
    "targets": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["topic_id"],
        "properties": {
          "topic_id": {"type": "string", "minLength": 1},
          "self_report": {"enum": ["unknown", "low", "medium", "high"], "default": "unknown"}
        }
      }
    },
    "availability": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["date", "minutes"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "minutes": {"type": "integer", "minimum": 0, "maximum": 480}
        }
      }
    }
  }
}
